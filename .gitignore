# ==========================================
# Quick Money Universal Master GitIgnore
# ==========================================

# 1. Environment & Sensitive Secrets (NEVER COMMIT)
.env
*.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# 2. Node.js & Dependencies
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 3. Database & Local Storage
*.sqlite
*.sqlite-journal
*.sqlite3
quick_money.sqlite
**/quick_money.sqlite

# 4. Flutter & Dart Builds
.dart_tool/
**/.dart_tool/
build/
**/build/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
.widget_preview/

# 5. Mobile Native Artifacts
**/android/app/debug/
**/android/app/profile/
**/android/app/release/
**/*.symbols
**/*.map.json
**/ios/Flutter/.last_build_id

# 6. Logs & OS Metadata
logs/
*.log
.DS_Store
Thumbs.db
.vscode/
.idea/
