PORT=5000
NODE_ENV=production

# Database Configuration
# Set DB_DIALECT=sqlite for local development
# Set DB_DIALECT=mysql for live cloud deployment on Render
DB_DIALECT=mysql
DB_STORAGE=./quick_money.sqlite

# Aiven Cloud MySQL (Live Cloud Database)
DB_HOST=your-aiven-mysql-host.aivencloud.com
DB_PORT=22890
DB_USER=avnadmin
DB_PASSWORD=your_aiven_mysql_password_here
DB_NAME=defaultdb
DB_SSL=true

# AES-256 Encryption Configuration (32-byte 256-bit Hex Key & 16-byte IV)
AES_SECRET_KEY=your_32_byte_aes_256_hex_secret_key
AES_IV=your_16_byte_hex_iv

# JWT Auth Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
JWT_REFRESH_EXPIRES_IN=30d

# Gmail SMTP Official Business Email Credentials
BREVO_FROM_NAME="Quick Money Security"
BREVO_FROM_EMAIL=quick.moneey.in@gmail.com
EMAIL_USER=quick.moneey.in@gmail.com
EMAIL_APP_PASSWORD="your-16-character-gmail-app-password"

# FinTech Business Logic Configuration
PROFIT_RETURN_THRESHOLD=100.00
MIN_WITHDRAWAL_LIMIT=100.00
DAILY_YIELD_RATE=0.025
WELCOME_BONUS=51.07
SWAGGER_SERVER_URL=https://quick-money-api.onrender.com

# ==========================================
# PhonePe Payment Gateway (PG) Configuration
# ==========================================
# Mode: 'SANDBOX' (Test Mode) or 'PRODUCTION' (Live Production)
PHONEPE_ENV=SANDBOX

# PhonePe Official Developer Sandbox (UAT) Credentials:
PHONEPE_MERCHANT_ID=PGTESTPAYUAT
PHONEPE_SALT_KEY=your_phonepe_salt_key_here
PHONEPE_SALT_INDEX=1

# API Base URL:
# Sandbox: https://api-preprod.phonepe.com/apis/pg-sandbox
# Production: https://api.phonepe.com/apis/hermes
PHONEPE_HOST_URL=https://api-preprod.phonepe.com/apis/pg-sandbox

# In-App Return & Server Webhook Callback URLs
PHONEPE_REDIRECT_URL=quickmoney://payment-return
PHONEPE_CALLBACK_URL=https://quick-money-api.onrender.com/api/v1/payments/phonepe/callback
